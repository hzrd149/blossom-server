{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "name": "@hzrd149/blossom-server",
  "version": "6.4.1",
  "exports": "./main.ts",
  "license": "MIT",
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "@hono/hono/jsx",
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns"]
  },
  "tasks": {
    "dev": "deno run -P --env-file=.env --watch main.ts",
    "start": "deno run -P --env-file=.env main.ts",
    "test": "deno test -P --env-file=.env tests/unit/ tests/e2e/ && deno task test:client && deno task check:admin",
    "test:client": "deno test --config src/landing/client/deno.json --lock=src/landing/client/deno.lock src/landing/client/identity.test.ts",
    "build": {
      "dependencies": ["build:client", "build:styles", "build:admin"]
    },
    "build:client": "deno bundle --frozen --lock=src/landing/client/deno.lock --config src/landing/client/deno.json --minify --platform browser -o public/client.js src/landing/client/index.tsx",
    "build:admin": {
      "dependencies": ["build:admin:client", "build:admin:styles"]
    },
    "build:admin:client": "deno bundle --frozen --lock=src/admin/client/deno.lock --config src/admin/client/deno.json --minify --platform browser -o public/admin/client.js src/admin/client/main.tsx",
    "build:admin:styles": "deno run --frozen --lock=src/admin/styles/deno.lock --config=src/admin/styles/deno.json -A npm:@tailwindcss/cli@4.3.5 -i src/admin/styles/input.css -o public/admin/styles.css --minify",
    "check:admin": "deno check --config src/admin/client/deno.json --lock=src/admin/client/deno.lock src/admin/client/main.tsx src/admin/client/api/queries.ts",
    "build:styles": "deno run --frozen --lock=src/landing/styles/deno.lock --config=src/landing/styles/deno.json -A npm:tailwindcss@3.4.17 -c tailwind.config.js -i src/landing/styles/input.css -o public/styles.css --minify",
    "check:nix": "deno task nix:check",
    "update:nix-hashes": "deno task nix:update",
    "nix:check": "bash scripts/nix-check.sh",
    "nix:update": "bash scripts/nix-update-hashes.sh",
    "scan": "deno run --allow-env --allow-sys --allow-write --allow-read --allow-run --deny-net npm:aislop scan"
  },
  "permissions": {
    "default": {
      "net": true,
      "read": true,
      "write": true,
      "env": true,
      "ffi": true,
      "sys": true,
      "run": true
    }
  },
  "fmt": {
    "lineWidth": 160,
    "exclude": [".planning", ".gsd"]
  },
  "imports": {
    "@bradenmacdonald/s3-lite-client": "jsr:@bradenmacdonald/s3-lite-client@^0.9.6",
    "@hono/hono": "jsr:@hono/hono@^4.13.19",
    "@libsql/client": "npm:@libsql/client@^0.17.4",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@std/crypto": "jsr:@std/crypto@^1.1.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "@std/yaml": "jsr:@std/yaml@^1.3.0",
    "nostr-tools": "npm:nostr-tools@^2.26.1",
    "sharp": "npm:sharp@^0.35.5",
    "file-type": "npm:file-type@^19.6.0",
    "yaml": "npm:yaml@^2.9.1",
    "zod": "npm:zod@^4.6.7"
  },
  "exclude": ["src/landing/client", "src/admin/client"]
}
